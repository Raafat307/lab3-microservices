    {
      "name": "Business Logic",
      "item": [
        {
          "name": "Get All Hotels",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Returns a list of hotels\", function () {\r\n    const hotels = pm.response.json();\r\n    pm.expect(hotels).to.be.an(\"array\");\r\n    pm.expect(hotels.length).to.be.greaterThan(0);\r\n});\r\n\r\n// احفظ hotelUid تلقائيًا\r\nif (pm.response.json().length > 0) {\r\n    pm.environment.set(\"hotelUid\", pm.response.json()[0].hotelUid);\r\n}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/hotels",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "hotels"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Book Hotel",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Response contains reservation details\", function () {\r\n    const data = pm.response.json();\r\n    pm.expect(data).to.have.property(\"reservationUid\");\r\n    pm.expect(data).to.have.property(\"hotelUid\");\r\n    pm.expect(data).to.have.property(\"discount\");\r\n    pm.expect(data).to.have.property(\"paymentPrice\");\r\n    pm.expect(data).to.have.property(\"status\");\r\n});\r\n\r\npm.test(\"Payment status is PAID\", function () {\r\n    pm.expect(pm.response.json().status).to.eql(\"PAID\");\r\n});\r\n\r\npm.test(\"Discount is applied correctly\", function () {\r\n    const data = pm.response.json();\r\n    const originalPrice = 10000;\r\n    const expectedPrice = originalPrice - (originalPrice * data.discount / 100);\r\n    pm.expect(data.paymentPrice).to.eql(expectedPrice);\r\n});\r\n\r\n// احفظ reservationUid\r\npm.environment.set(\"reservationUid\", pm.response.json().reservationUid);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"username\": \"{{username}}\",\r\n    \"hotelUid\": \"{{hotelUid}}\",\r\n    \"startDate\": \"2027-01-01T00:00:00+00:00\",\r\n    \"endDate\": \"2027-01-05T00:00:00+00:00\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/reservations",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "reservations"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get My Reservations",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Returns list of reservations\", function () {\r\n    const reservations = pm.response.json();\r\n    pm.expect(reservations).to.be.an(\"array\");\r\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/reservations?username={{username}}",
              "host": [
                "{{baseUrl}}"
